# Copy this file to .env and fill it in. .env is git-ignored.
# Real environment variables take priority over this file.

# Required: the seeded customer the virtual users sign in as
TEST_USERNAME=
TEST_PASSWORD=

# Where JMeter is installed (default C:\dev\tools\apache-jmeter-5.6.3)
# JMETER_HOME=C:\dev\tools\apache-jmeter-5.6.3

# Java 8 or newer. Optional if java is on the PATH.
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.13.9-hotspot

# Open the HTML dashboard in Chrome after a run: always, on-failure, or never
# OPEN_REPORT=always
