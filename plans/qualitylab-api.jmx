<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick random stay dates">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// A random stay 400 to 1,100 days ahead, 1 to 3 nights, so parallel users rarely want the same room
// on the same nights, and real visitors are not affected.
def random = new Random()
def start = java.time.LocalDate.now().plusDays(400 + random.nextInt(700))
vars.put('checkIn', start.toString())
vars.put('checkOut', start.plusDays(1 + random.nextInt(3)).toString())</stringProp>
</JSR223PreProcessor>
<hashTree></hashTree>
