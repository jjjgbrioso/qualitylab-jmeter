<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="_Safety check and credentials">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// SAFETY CHECK (runs once, before any virtual user starts)
// 1. Reads the credentials from environment variables, so they never appear in files, logs or reports.
// 2. Refuses unsafe runs against the deployed (public) site.
def env = System.getenv()
['TEST_USERNAME': 'testUsername', 'TEST_PASSWORD': 'testPassword'].each { variable, property -&gt;
    if (!props.getProperty(property)) {
        def value = env.get(variable)
        if (!value) {
            SampleResult.setSuccessful(false)
            SampleResult.setResponseMessage(&quot;Set the environment variable &quot; + variable + &quot; (see README).&quot;)
            SampleResult.setStopTest(true)
            return
        }
        props.put(property, value)
    }
}

def host = props.getProperty('host', 'localhost')
def local = ['localhost', '127.0.0.1'].contains(host)
def profile = props.getProperty('profile', 'custom')
int users = (props.getProperty('users', '1') as int) + (props.getProperty('spikeUsers', '0') as int)
int maxUsers = props.getProperty('deployedMaxUsers', '5') as int
boolean allowHighLoad = props.getProperty('allowHighLoad', 'false') == 'true'
boolean approved = props.getProperty('approved', 'false') == 'true'

def problem = null
if (!local &amp;&amp; ['stress', 'spike', 'endurance'].contains(profile) &amp;&amp; !allowHighLoad) {
    problem = &quot;The &quot; + profile + &quot; profile is not allowed against the deployed site &quot; + host + &quot;. Run it with the LOCAL target.&quot;
} else if (!local &amp;&amp; !['smoke', 'baseline'].contains(profile) &amp;&amp; !approved &amp;&amp; !allowHighLoad) {
    problem = &quot;The &quot; + profile + &quot; profile against the deployed site needs approval (approved=true).&quot;
} else if (!local &amp;&amp; users &gt; maxUsers &amp;&amp; !allowHighLoad) {
    problem = users + &quot; users is above the limit of &quot; + maxUsers + &quot; for the deployed site.&quot;
}

if (problem) {
    log.error(&quot;SAFETY CHECK: &quot; + problem)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(problem)
    SampleResult.setStopTest(true)
} else {
    log.info(&quot;SAFETY CHECK passed: profile=&quot; + profile + &quot;, target=&quot; + host + &quot;, users=&quot; + users)
    SampleResult.setResponseMessage(&quot;Safety check passed: &quot; + profile + &quot; against &quot; + host + &quot; with &quot; + users + &quot; users&quot;)
}</stringProp>
</JSR223Sampler>
