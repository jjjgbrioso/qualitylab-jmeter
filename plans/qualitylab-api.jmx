<JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="_Auto-stop when limits are reached (stopErrorPct, stopP95Ms)">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// AUTO-STOP (stress and spike safety net)
// Watches the last 200 samples. When their error rate or 95th percentile passes the profile's limit
// (stopErrorPct, stopP95Ms), it stops the test gracefully: that is the limit the run was looking for.
def maxErrorPct = (props.getProperty('stopErrorPct', '0') as double)
def maxP95 = (props.getProperty('stopP95Ms', '0') as long)
if (maxErrorPct &lt;= 0 &amp;&amp; maxP95 &lt;= 0) return
def label = prev.getSampleLabel()
if (label.startsWith('_') || label.startsWith('Journey')) return

def window = props.get('autoStopWindow')
if (window == null) {
    synchronized (props) {
        window = props.get('autoStopWindow')
        if (window == null) { window = new java.util.concurrent.ConcurrentLinkedDeque(); props.put('autoStopWindow', window) }
    }
}
window.add([prev.getTime(), prev.isSuccessful()])
while (window.size() &gt; 200) window.pollFirst()
if (window.size() &lt; 200 || props.get('autoStopped') != null) return

def samples = window.toArray()
def errors = samples.count { !it[1] }
def errorPct = errors * 100.0 / samples.length
def times = samples.collect { it[0] }.sort()
def p95 = times[(int) Math.ceil(times.size() * 0.95) - 1]
def reason = null
if (maxErrorPct &gt; 0 &amp;&amp; errorPct &gt; maxErrorPct) reason = String.format('error rate %.1f%% &gt; %.1f%%', errorPct, maxErrorPct)
else if (maxP95 &gt; 0 &amp;&amp; p95 &gt; maxP95) reason = &quot;95th percentile &quot; + p95 + &quot; ms &gt; &quot; + maxP95 + &quot; ms&quot;
if (reason != null &amp;&amp; props.putIfAbsent('autoStopped', reason) == null) {
    log.warn(&quot;AUTO-STOP: limit reached (&quot; + reason + &quot;) over the last 200 samples. Stopping the test.&quot;)
    ctx.getEngine().askThreadsToStop()
}</stringProp>
</JSR223Listener>
