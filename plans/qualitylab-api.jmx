    <collectionProp name="Arguments.arguments">
      <elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;roomId&quot;:&quot;${roomId}&quot;,&quot;checkIn&quot;:&quot;${checkIn}&quot;,&quot;checkOut&quot;:&quot;${checkOut}&quot;,&quot;guests&quot;:1,&quot;leadGuestName&quot;:&quot;JMeter user ${__threadNum}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
    </collectionProp>
  </elementProp>
</HTTPSamplerProxy>
