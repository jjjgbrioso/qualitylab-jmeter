    <stringProp name="LoopController.loops">-1</stringProp>
    <boolProp name="LoopController.continue_forever">false</boolProp>
  </elementProp>
  <stringProp name="ThreadGroup.num_threads">${__P(spikeUsers,0)}</stringProp>
  <stringProp name="ThreadGroup.ramp_time">${__P(spikeRamp,5)}</stringProp>
  <boolProp name="ThreadGroup.scheduler">true</boolProp>
  <stringProp name="ThreadGroup.duration">${__P(spikeDuration,60)}</stringProp>
  <stringProp name="ThreadGroup.delay">${__P(spikeDelay,0)}</stringProp>
  <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
  <stringProp name="TestPlan.comments">Only used by the spike profile: spikeUsers arrive after spikeDelay seconds, within spikeRamp seconds, and stay for spikeDuration seconds. With spikeUsers=0 this group does nothing.</stringProp>
</ThreadGroup>
